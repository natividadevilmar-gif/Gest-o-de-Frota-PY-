# Banco PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frota"
# Segredo para assinar o cookie de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET="troque-este-valor"
# Fonte de telemetria: "simulador" até escolher o white-label
TELEMETRIA_FONTE="simulador"
# Leitura de recibos por foto e de despesas faladas (Claude API)
ANTHROPIC_API_KEY=""
# Cotação usada para converter recibos em guaranis e reais
COTACAO_PYG_POR_USD="7300"
COTACAO_BRL_POR_USD="5.40"
COTACAO_ARS_POR_USD="1450"
# Wialon (Gurtam): token da Remote API, servidor (hst-api.wialon.us para hosting.wialon.us)
# e os clientes cujos caminhões vêm do Wialon (separados por vírgula; vazio = todos)
WIALON_TOKEN=""
WIALON_HOST="hst-api.wialon.us"
WIALON_CLIENTES="AVM Truck"
