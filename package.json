{
  "name": "gestao-de-frota-py",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copiar-ocr.mjs && prisma generate && next build",
    "start": "next start",
    "vercel-build": "node scripts/copiar-ocr.mjs && prisma generate && sh scripts/preparar-banco.sh && next build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "sync:telemetria": "tsx scripts/sync-telemetria.ts",
    "rastreador": "tsx scripts/rastreador.ts",
    "wialon": "tsx scripts/wialon.ts",
    "simular:aparelho": "tsx scripts/simular-aparelho.ts",
    "simular:camera": "tsx scripts/simular-camera.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
