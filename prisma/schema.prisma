// Gestão de Frota PY: modelo de dados do MVP.
// Valores em USD, sem IVA. Cada transportadora (Cliente) só enxerga os próprios dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  BASICO
  GESTAO
  VIDEO
}

enum Papel {
  ADMIN // equipe interna da Gestão de Frota PY
  GESTOR // gestor da transportadora
  OPERADOR // lança despesas e viagens, não altera cadastros
  MOTORISTA // entra com celular e PIN e só lança despesas do próprio caminhão
}

enum Idioma {
  pt
  es
  en
  de
}

enum CategoriaDespesa {
  DIESEL
  ARLA32
  ALIMENTACAO
  PNEUS // aparece como "Borracharia"
  MANUTENCAO
  PEDAGIO
  OUTROS
}

enum Gatilho {
  KM
  DATA
  FALHA
}

model Cliente {
  id                   String          @id @default(cuid())
  nome                 String
  ruc                  String?
  cidade               String
  idioma               Idioma          @default(pt)
  // País de origem (ISO 3166, duas letras): define as cores da plataforma para o cliente.
  pais                 String          @default("PY")
  // Dias desde o vencimento da mensalidade mais antiga em aberto (0 = em dia).
  diasEmAtraso         Int             @default(0)
  // Contrato de prestação de serviço: plano, quantidade, prazo e vencimento.
  planoContratado      Plano           @default(GESTAO)
  caminhoesContratados Int             @default(1)
  prazoMeses           Int             @default(12)
  diaVencimento        Int             @default(10)
  contratoInicio       DateTime?
  endereco             String?
  // Painel do fabricante do MDVR (4 câmeras), aberto pelo menu Vídeo até a integração completa.
  mdvrUrl              String?
  // Conta Wialon do cliente: token da Remote API (só leitura) e servidor (ex.: hst-api.wialon.us).
  wialonToken          String?
  wialonHost           String?
  // Conta CUSAT (ou outra plataforma GPSWOX) do cliente: servidor e chave da API devolvida no login.
  gpswoxHost           String?
  gpswoxEmail          String?
  gpswoxHash           String?
  criadoEm             DateTime        @default(now())
  usuarios             Usuario[]
  caminhoes            Caminhao[]
  motoristas           Motorista[]
  caixas               CaixaViagem[]
  rotasFrete           RotaFrete[]
  cercas               Cerca[]
  ocorrencias          Ocorrencia[]
  comandos             Comando[]
  midias               Midia[]
  registrosCarga       RegistroCarga[]
  mics                 MicDta[]
}

model Usuario {
  id          String     @id @default(cuid())
  email       String     @unique
  nome        String
  senhaHash   String
  papel       Papel
  clienteId   String?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // Idioma escolhido pelo próprio usuário (null = idioma do cliente).
  idioma      Idioma?
  // Só para papel MOTORISTA: o motorista dono deste acesso.
  motoristaId String?    @unique
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  despesas    Despesa[]
  criadoEm    DateTime   @default(now())
}

model Motorista {
  id             String          @id @default(cuid())
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome           String
  documento      String?
  // Código do país do celular (595, 55, 54…) para o WhatsApp; o login continua sendo o número local.
  ddi            String?
  caminhoes      Caminhao[]
  acesso         Usuario?
  viagens        Viagem[]
  caixas         CaixaViagem[]
  registrosCarga RegistroCarga[]
}

model Caminhao {
  id                String          @id @default(cuid())
  clienteId         String
  cliente           Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  placa             String
  modelo            String
  ano               Int?
  plano             Plano           @default(BASICO)
  // Consumo de referência do modelo (manual ou média da frota), em km/l.
  consumoRefKmL     Float
  odometroKm        Int             @default(0)
  // Identificador do equipamento na plataforma de rastreamento.
  rastreadorId      String?
  // Último pacote que o aparelho mandou direto ao receptor próprio (sem passar pelo Wialon).
  diretoEm          DateTime?
  // Última posição recebida do rastreador próprio (atualizada pelo receptor).
  ultimaPosicaoEm   DateTime?
  ultimaLat         Float?
  ultimaLng         Float?
  ultimaVelocidade  Int?
  // Rumo da última posição, em graus (0 = norte), para o caminhão no mapa apontar para onde vai.
  ultimaDirecao     Int?
  // Unidade que é a base de abastecimento do cliente (ex.: "Surtidor" no Wialon), não um caminhão:
  // fica fora do mapa, dos alertas e do relatório, e aparece no quadro próprio da Telemetria.
  baseCombustivel   Boolean         @default(false)
  ultimaIgnicao     Boolean?
  // Cerca onde o caminhão está agora (para detectar entrada e saída).
  cercaAtualId      String?
  // Eixos do conjunto (cavalo + carreta): o pedágio é cobrado por eixo na maioria das praças.
  eixos             Int             @default(6)
  // Câmeras do plano Vídeo: "dualcam" (Teltonika, integrada) ou "mdvr4" (MDVR de 4 câmeras).
  camera            String          @default("dualcam")
  // Saída do rastreador que corta o motor (DOUT1), confirmada pelo aparelho.
  motorBloqueado    Boolean         @default(false)
  motoristaId       String?
  motorista         Motorista?      @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  // Custos fixos mensais que entram no custo por km.
  salarioMotorista  Float           @default(0)
  seguroMensal      Float           @default(0)
  depreciacaoMensal Float           @default(0)
  despesas          Despesa[]
  telemetria        TelemetriaDia[]
  revisoes          ItemRevisao[]
  viagens           Viagem[]
  caixas            CaixaViagem[]
  posicoes          Posicao[]
  ocorrencias       Ocorrencia[]
  comandos          Comando[]
  midias            Midia[]
  registrosCarga    RegistroCarga[]
  criadoEm          DateTime        @default(now())

  @@unique([clienteId, placa])
}

model Despesa {
  id            String           @id @default(cuid())
  caminhaoId    String
  caminhao      Caminhao         @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  data          DateTime         @db.Date
  categoria     CategoriaDespesa
  // Valor sempre gravado em USD. Quando lançado em guaranis ou reais, guardamos
  // o valor original e a cotação usada na conversão.
  valorUsd      Float
  moeda         String           @default("USD")
  valorOriginal Float?
  cotacao       Float?
  // Abastecimento (DIESEL e ARLA32): litros, preço e posto. Os litros de diesel
  // são comparados com o consumo medido pela CAN.
  litros        Float?
  precoLitro    Float?
  posto         String?
  // Odômetro no abastecimento e se completou o tanque: permite medir km/l
  // entre dois tanques cheios em caminhões sem leitura CAN.
  odometroKm    Int?
  tanqueCheio   Boolean          @default(false)
  descricao     String?
  // Foto do recibo (JPEG reduzido no celular antes do envio).
  recibo        Bytes?
  reciboTipo    String?
  // Como foi lançado: "manual", "foto" ou "audio".
  origem        String           @default("manual")
  // Quem lançou (motoristas veem só os próprios lançamentos).
  usuarioId     String?
  usuario       Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime         @default(now())

  @@index([caminhaoId, data])
}

model TelemetriaDia {
  id                 String   @id @default(cuid())
  caminhaoId         String
  caminhao           Caminhao @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  data               DateTime @db.Date
  km                 Float
  // Litros consumidos lidos da rede CAN (null quando o equipamento não lê CAN).
  litrosCan          Float?
  odometroKm         Int
  marchaLentaPct     Float    @default(0)
  excessosVelocidade Int      @default(0)
  frenagensBruscas   Int      @default(0)
  rpmAltoPct         Float    @default(0)

  @@unique([caminhaoId, data])
}

model ItemRevisao {
  id            String           @id @default(cuid())
  caminhaoId    String
  caminhao      Caminhao         @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  nome          String
  gatilho       Gatilho
  intervaloKm   Int?
  ultimoKm      Int?
  vencimento    DateTime?        @db.Date
  intervaloDias Int?
  resolvido     Boolean          @default(false)
  // Item do plano de demonstração (botão do admin): aparece mesmo fora do plano Gestão e não lança despesa.
  demo          Boolean          @default(false)
  servicos      ServicoRevisao[]
}

model ServicoRevisao {
  id         String      @id @default(cuid())
  itemId     String
  item       ItemRevisao @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data       DateTime    @db.Date
  odometroKm Int
  custoUsd   Float
  observacao String?
}

model Viagem {
  id              String        @id @default(cuid())
  caminhaoId      String
  caminhao        Caminhao      @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  data            DateTime      @db.Date
  origem          String
  destino         String
  carga           String
  toneladas       Float
  freteUsd        Float
  kmCarregado     Float
  kmVazio         Float
  // Detalhes do frete. Origem/destino são as cidades; os países ficam em ISO de duas letras.
  embarcador      String?
  paisOrigem      String        @default("PY")
  paisDestino     String        @default("PY")
  moeda           String        @default("USD")
  valorOriginal   Float?
  precoTonelada   Float?
  motoristaId     String?
  motorista       Motorista?    @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  dataEntrega     DateTime?     @db.Date
  documento       String?
  // Aduana, despachante, balança, chapa: custos só desta viagem, em USD, fora do custo por km.
  custosExtrasUsd Float         @default(0)
  recebido        Boolean       @default(false)
  vencimento      DateTime?     @db.Date
  observacao      String?
  // Rota de pedágio escolhida no frete, para o pedágio previsto.
  rotaPedagioId   String?
  rotaPedagio     RotaPedagio?  @relation(fields: [rotaPedagioId], references: [id], onDelete: SetNull)
  // Caminho previsto de origem a destino ([[lat, lng], ...]), para o alerta de desvio de rota.
  rota            Json?
  rotaKm          Float?
  // Por que a rota não saiu (cidade não achada, sem conexão...); null quando deu certo.
  rotaErro        String?
  // Link público para quem vai receber a carga acompanhar o caminhão (sem login), até expirar.
  linkToken       String?       @unique
  linkExpiraEm    DateTime?
  mic             MicDta?
  recebimentos    Recebimento[]
  criadoEm        DateTime      @default(now())

  @@index([caminhaoId, data])
}

// Caixa da viagem: dinheiro entregue ao motorista quando sai. As despesas dele a partir
// dessa data (até o próximo caixa ou o fechamento) saem desse dinheiro.
model CaixaViagem {
  id            String    @id @default(cuid())
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoristaId   String
  motorista     Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  caminhaoId    String?
  caminhao      Caminhao? @relation(fields: [caminhaoId], references: [id], onDelete: SetNull)
  data          DateTime  @db.Date
  moeda         String    @default("PYG")
  valorOriginal Float
  valorUsd      Float
  observacao    String?
  fechadoEm     DateTime? @db.Date
  criadoEm      DateTime  @default(now())

  @@index([motoristaId, data])
}

// Cotação do dia usada para converter despesas lançadas em moeda local.
model Cotacao {
  id        String   @id @default(cuid())
  data      DateTime @unique @db.Date
  pygPorUsd Float
  brlPorUsd Float
  arsPorUsd Float?
  fonte     String
  criadoEm  DateTime @default(now())
}

// Cada registro enviado pelo aparelho no caminhão (receptor próprio, protocolo Teltonika).
model Posicao {
  id                BigInt   @id @default(autoincrement())
  caminhaoId        String
  caminhao          Caminhao @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  // Hora do GPS, em UTC.
  data              DateTime
  lat               Float
  lng               Float
  velocidadeKmh     Int
  direcao           Int      @default(0)
  satelites         Int      @default(0)
  ignicao           Boolean?
  // Odômetro total em km (da rede CAN quando houver, senão o do GPS).
  odometroKm        Float?
  // Combustível consumido acumulado, em litros, lido da CAN.
  litrosTotal       Float?
  // Diesel no tanque, em litros (sensor de nível ou CAN).
  nivelCombustivelL Float?
  rpm               Int?
  // Eventos de condução: "freada", "aceleracao", "curva", "excesso".
  evento            String?
  recebidoEm        DateTime @default(now())

  @@index([caminhaoId, data])
}

// Área circular no mapa: pátio, cliente, fronteira ou área de risco.
// Entrar ou sair dela gera uma ocorrência na central de monitoramento.
model Cerca {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  // "patio", "cliente", "fronteira" ou "risco".
  tipo      String
  lat       Float
  lng       Float
  raioM     Int
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

// Alerta da central de monitoramento, do momento em que acontece até ser resolvido.
model Ocorrencia {
  id            String    @id @default(cuid())
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  caminhaoId    String
  caminhao      Caminhao  @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  // excesso, sem_sinal, ignicao_noturna, entrada_cerca, saida_cerca, freada, aceleracao, curva.
  tipo          String
  // "alta", "media" ou "baixa".
  gravidade     String
  titulo        String
  detalhe       String
  lat           Float?
  lng           Float?
  velocidadeKmh Int?
  // Evita repetir o mesmo alerta (ex.: um excesso por caminhão por hora).
  chave         String    @unique
  // "aberta", "atendimento" ou "resolvida".
  status        String    @default("aberta")
  atendidaPor   String?
  atendidaEm    DateTime?
  resolvidaEm   DateTime?
  observacao    String?
  criadaEm      DateTime  @default(now())
  midias        Midia[]

  @@index([clienteId, status, criadaEm])
}

// Ordem enviada ao rastreador (Codec 12): bloquear motor, pedir posição, foto...
// O receptor envia quando o aparelho está conectado e grava a resposta.
model Comando {
  id           String    @id @default(cuid())
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  caminhaoId   String
  caminhao     Caminhao  @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  // bloquear, desbloquear, posicao, status, info, reiniciar, foto, video ou livre.
  tipo         String
  // Texto que vai para o aparelho, ex.: "setdigout 1".
  texto        String
  // pendente, aguardando (bloqueio esperando o caminhão parar), enviado, respondido, erro ou cancelado.
  status       String    @default("pendente")
  resposta     String?
  motivo       String?
  criadoPor    String
  criadoEm     DateTime  @default(now())
  enviadoEm    DateTime?
  respondidoEm DateTime?

  @@index([caminhaoId, status])
  @@index([clienteId, criadoEm])
}

// Foto ou vídeo das câmeras do caminhão (Teltonika DualCam), pedido pela central
// ou disparado por um evento (freada brusca, excesso, colisão...).
model Midia {
  id            String      @id @default(cuid())
  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  caminhaoId    String
  caminhao      Caminhao    @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  ocorrenciaId  String?
  ocorrencia    Ocorrencia? @relation(fields: [ocorrenciaId], references: [id], onDelete: SetNull)
  // "foto" ou "video".
  tipo          String
  // "frontal" (estrada) ou "cabine".
  camera        String
  // pedido, freada, aceleracao, curva, excesso, colisao, panico ou evento.
  gatilho       String
  data          DateTime
  lat           Float?
  lng           Float?
  velocidadeKmh Int?
  duracaoS      Int?
  // image/jpeg, video/mp4 ou video/h265 (sem conversão).
  formato       String?
  conteudo      Bytes?
  tamanho       Int?
  // Demonstração: sem arquivo, a tela desenha a cena.
  demo          Boolean     @default(false)
  // Evita gerar a mesma mídia de demonstração duas vezes.
  chave         String?     @unique
  criadoEm      DateTime    @default(now())

  @@index([clienteId, data])
  @@index([caminhaoId, data])
}

// Praça de pedágio (peaje) com a tarifa de caminhão pesado.
// Tarifa por eixo (Brasil, Argentina) ou valor fixo por caminhão pesado (Paraguai, Uruguai).
model PracaPedagio {
  id           String   @id
  pais         String
  rodovia      String
  nome         String
  lat          Float
  lng          Float
  moeda        String
  // Valor por eixo; quando null, vale `tarifaFixa` para o caminhão pesado inteiro.
  tarifaEixo   Float?
  tarifaFixa   Float?
  // Cobrança só num sentido (algumas praças do Brasil): o valor já é o da ida.
  sentido      String?
  fonte        String
  vigencia     DateTime @db.Date
  atualizadoEm DateTime @updatedAt
}

// Rota (corredor) com as praças que o caminhão passa, em ordem.
model RotaPedagio {
  id      String   @id
  nome    String
  origem  String
  destino String
  paises  String
  km      Int
  pracas  String[]
  viagens Viagem[]
}

// Rota pré-definida do simulador de frete: cidades, km de ida e as praças de pedágio do caminho.
model RotaFrete {
  id            String   @id @default(cuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  origem        String
  paisOrigem    String   @default("PY")
  destino       String
  paisDestino   String   @default("PY")
  km            Int
  rotaPedagioId String?
  // Praças de pedágio por onde a rota passa, na ordem da ida.
  pracas        String[] @default([])
  // Países por onde a rota passa (para a média do diesel), na ordem da ida.
  paises        String[] @default([])
  criadoEm      DateTime @default(now())

  @@index([clienteId])
}

// Preço do diesel na bomba por país, para o simulador de frete (a KM Cero atualiza).
model PrecoDiesel {
  pais         String   @id
  moeda        String
  valor        Float
  fonte        String
  vigencia     DateTime @db.Date
  atualizadoEm DateTime @default(now()) @updatedAt
}

// Foto ou vídeo curto da carga feito pelo motorista no celular. A data e a hora são as do
// servidor na chegada do arquivo (o celular não consegue mudar), com o local do GPS do celular.
model RegistroCarga {
  id          String     @id @default(cuid())
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  caminhaoId  String
  caminhao    Caminhao   @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  motoristaId String?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  usuarioId   String?
  // "foto" ou "video".
  tipo        String
  // image/jpeg, video/webm ou video/mp4.
  formato     String
  conteudo    Bytes
  tamanho     Int
  duracaoS    Int?
  lat         Float?
  lng         Float?
  precisaoM   Int?
  observacao  String?
  criadoEm    DateTime   @default(now())

  @@index([clienteId, criadoEm])
  @@index([caminhaoId, criadoEm])
}

// MIC/DTA do frete internacional: os campos do formulário (ver src/lib/micDta.ts) e a sequência
// do número no ano, para sugerir o próximo.
model MicDta {
  id           String   @id @default(cuid())
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  viagemId     String   @unique
  viagem       Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  caminhaoId   String
  ano          Int
  sequencia    Int
  dados        Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, ano, sequencia])
  @@index([caminhaoId, atualizadoEm])
}

// Pagamento recebido de um frete (pode ser em parcelas). Quando a soma cobre o frete,
// o frete fica marcado como recebido.
model Recebimento {
  id         String   @id @default(cuid())
  viagemId   String
  viagem     Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  data       DateTime @db.Date
  valorUsd   Float
  observacao String?
  usuarioId  String?
  criadoEm   DateTime @default(now())

  @@index([viagemId])
  @@index([data])
}
