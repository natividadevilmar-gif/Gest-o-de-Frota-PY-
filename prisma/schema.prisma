// Gestão de Frota PY: modelo de dados do MVP.
// Valores em USD, sem IVA. Cada transportadora (Cliente) só enxerga os próprios dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  BASICO
  GESTAO
  VIDEO
}

enum Papel {
  ADMIN // equipe interna da Gestão de Frota PY
  GESTOR // gestor da transportadora
  OPERADOR // lança despesas e viagens, não altera cadastros
  MOTORISTA // entra com celular e PIN e só lança despesas do próprio caminhão
}

enum Idioma {
  pt
  es
}

enum CategoriaDespesa {
  DIESEL
  ARLA32
  ALIMENTACAO
  PNEUS // aparece como "Borracharia"
  MANUTENCAO
  PEDAGIO
  OUTROS
}

enum Gatilho {
  KM
  DATA
  FALHA
}

model Cliente {
  id           String        @id @default(cuid())
  nome         String
  ruc          String?
  cidade       String
  idioma       Idioma        @default(pt)
  // País de origem (ISO 3166, duas letras): define as cores da plataforma para o cliente.
  pais         String        @default("PY")
  // Dias desde o vencimento da mensalidade mais antiga em aberto (0 = em dia).
  diasEmAtraso Int           @default(0)
  criadoEm     DateTime      @default(now())
  usuarios     Usuario[]
  caminhoes    Caminhao[]
  motoristas   Motorista[]
  caixas       CaixaViagem[]
}

model Usuario {
  id          String     @id @default(cuid())
  email       String     @unique
  nome        String
  senhaHash   String
  papel       Papel
  clienteId   String?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // Idioma escolhido pelo próprio usuário (null = idioma do cliente).
  idioma      Idioma?
  // Só para papel MOTORISTA: o motorista dono deste acesso.
  motoristaId String?    @unique
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  despesas    Despesa[]
  criadoEm    DateTime   @default(now())
}

model Motorista {
  id        String        @id @default(cuid())
  clienteId String
  cliente   Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  documento String?
  caminhoes Caminhao[]
  acesso    Usuario?
  viagens   Viagem[]
  caixas    CaixaViagem[]
}

model Caminhao {
  id                String          @id @default(cuid())
  clienteId         String
  cliente           Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  placa             String
  modelo            String
  ano               Int?
  plano             Plano           @default(BASICO)
  // Consumo de referência do modelo (manual ou média da frota), em km/l.
  consumoRefKmL     Float
  odometroKm        Int             @default(0)
  // Identificador do equipamento na plataforma de rastreamento.
  rastreadorId      String?
  motoristaId       String?
  motorista         Motorista?      @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  // Custos fixos mensais que entram no custo por km.
  salarioMotorista  Float           @default(0)
  seguroMensal      Float           @default(0)
  depreciacaoMensal Float           @default(0)
  despesas          Despesa[]
  telemetria        TelemetriaDia[]
  revisoes          ItemRevisao[]
  viagens           Viagem[]
  caixas            CaixaViagem[]
  criadoEm          DateTime        @default(now())

  @@unique([clienteId, placa])
}

model Despesa {
  id            String           @id @default(cuid())
  caminhaoId    String
  caminhao      Caminhao         @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  data          DateTime         @db.Date
  categoria     CategoriaDespesa
  // Valor sempre gravado em USD. Quando lançado em guaranis ou reais, guardamos
  // o valor original e a cotação usada na conversão.
  valorUsd      Float
  moeda         String           @default("USD")
  valorOriginal Float?
  cotacao       Float?
  // Abastecimento (DIESEL e ARLA32): litros, preço e posto. Os litros de diesel
  // são comparados com o consumo medido pela CAN.
  litros        Float?
  precoLitro    Float?
  posto         String?
  // Odômetro no abastecimento e se completou o tanque: permite medir km/l
  // entre dois tanques cheios em caminhões sem leitura CAN.
  odometroKm    Int?
  tanqueCheio   Boolean          @default(false)
  descricao     String?
  // Foto do recibo (JPEG reduzido no celular antes do envio).
  recibo        Bytes?
  reciboTipo    String?
  // Como foi lançado: "manual", "foto" ou "audio".
  origem        String           @default("manual")
  // Quem lançou (motoristas veem só os próprios lançamentos).
  usuarioId     String?
  usuario       Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime         @default(now())

  @@index([caminhaoId, data])
}

model TelemetriaDia {
  id                 String   @id @default(cuid())
  caminhaoId         String
  caminhao           Caminhao @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  data               DateTime @db.Date
  km                 Float
  // Litros consumidos lidos da rede CAN (null quando o equipamento não lê CAN).
  litrosCan          Float?
  odometroKm         Int
  marchaLentaPct     Float    @default(0)
  excessosVelocidade Int      @default(0)
  frenagensBruscas   Int      @default(0)
  rpmAltoPct         Float    @default(0)

  @@unique([caminhaoId, data])
}

model ItemRevisao {
  id            String           @id @default(cuid())
  caminhaoId    String
  caminhao      Caminhao         @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  nome          String
  gatilho       Gatilho
  intervaloKm   Int?
  ultimoKm      Int?
  vencimento    DateTime?        @db.Date
  intervaloDias Int?
  resolvido     Boolean          @default(false)
  servicos      ServicoRevisao[]
}

model ServicoRevisao {
  id         String      @id @default(cuid())
  itemId     String
  item       ItemRevisao @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data       DateTime    @db.Date
  odometroKm Int
  custoUsd   Float
  observacao String?
}

model Viagem {
  id              String     @id @default(cuid())
  caminhaoId      String
  caminhao        Caminhao   @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)
  data            DateTime   @db.Date
  origem          String
  destino         String
  carga           String
  toneladas       Float
  freteUsd        Float
  kmCarregado     Float
  kmVazio         Float
  // Detalhes do frete. Origem/destino são as cidades; os países ficam em ISO de duas letras.
  embarcador      String?
  paisOrigem      String     @default("PY")
  paisDestino     String     @default("PY")
  moeda           String     @default("USD")
  valorOriginal   Float?
  precoTonelada   Float?
  motoristaId     String?
  motorista       Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  dataEntrega     DateTime?  @db.Date
  documento       String?
  // Aduana, despachante, balança, chapa: custos só desta viagem, em USD, fora do custo por km.
  custosExtrasUsd Float      @default(0)
  recebido        Boolean    @default(false)
  vencimento      DateTime?  @db.Date
  observacao      String?
  criadoEm        DateTime   @default(now())

  @@index([caminhaoId, data])
}

// Caixa da viagem: dinheiro entregue ao motorista quando sai. As despesas dele a partir
// dessa data (até o próximo caixa ou o fechamento) saem desse dinheiro.
model CaixaViagem {
  id            String    @id @default(cuid())
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoristaId   String
  motorista     Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  caminhaoId    String?
  caminhao      Caminhao? @relation(fields: [caminhaoId], references: [id], onDelete: SetNull)
  data          DateTime  @db.Date
  moeda         String    @default("PYG")
  valorOriginal Float
  valorUsd      Float
  observacao    String?
  fechadoEm     DateTime? @db.Date
  criadoEm      DateTime  @default(now())

  @@index([motoristaId, data])
}

// Cotação do dia usada para converter despesas lançadas em moeda local.
model Cotacao {
  id        String   @id @default(cuid())
  data      DateTime @unique @db.Date
  pygPorUsd Float
  brlPorUsd Float
  arsPorUsd Float?
  fonte     String
  criadoEm  DateTime @default(now())
}
